DROP function if exists CalculateYearDiff;
DELIMITER //

CREATE FUNCTION CalculateYearDiff(input_year INT)
RETURNS INT
DETERMINISTIC
BEGIN
    DECLARE year_date DATE;
    DECLARE year_diff INT;
    
    IF input_year IS NULL OR input_year < 1000 OR input_year > curdate() THEN
        RETURN NULL;
    END IF;
    
    SET year_date = MAKEDATE(input_year, 1);
    
    SET year_diff = TIMESTAMPDIFF(YEAR, year_date, CURDATE());
    IF year_diff < 0 THEN
        RETURN 0;
    END IF;
    
    RETURN year_diff;
END //

DELIMITER ;

ALTER TABLE infectious_cases
ADD COLUMN year_diff INT;

SET SQL_SAFE_UPDATES = 0;

UPDATE infectious_cases
SET year_diff = CalculateYearDiff(Year)
WHERE Year IS NOT NULL;

SET SQL_SAFE_UPDATES = 1;

